Ejercicio 1

C++
#include <iostream>
#include <vector>

using namespace std;

int main() {
    int n;
    cout << "Cantidad de estudiantes: ";
    cin >> n;
    
    vector<float> notas(n);
    float suma = 0, mayor = 0, menor = 0;
    
    for (int i = 0; i < n; i++) {
        do {
            cout << "Ingrese la nota " << i + 1 << " (0 - 100): ";
            cin >> notas[i];
        } while (notas[i] < 0 || notas[i] > 100);
        
        suma += notas[i];
        
        if (i == 0 || notas[i] > mayor) {
            mayor = notas[i];
        }
        if (i == 0 || notas[i] < menor) {
            menor = notas[i];
        }
    }
    
    cout << "\nNotas registradas: ";
    for (int i = 0; i < n; i++) {
        cout << notas[i] << " ";
    }
    cout << "\n";
    
    cout << "Promedio general: " << suma / n << "\n";
    cout << "Nota mayor: " << mayor << "\n";
    cout << "Nota menor: " << menor << "\n";
    
    return 0;
}
Ejercicio 2

C++
#include <iostream>
#include <vector>
#include <string>

using namespace std;

int main() {
    vector<float> ventas(7);
    vector<string> dias = {"Lunes", "Martes", "Miercoles", "Jueves", "Viernes", "Sabado", "Domingo"};
    
    float total = 0, mayor = 0, menor = 0;
    int dia_mayor = 0, dia_menor = 0;
    
    for (int i = 0; i < 7; i++) {
        cout << "Ventas del dia " << dias[i] << ": ";
        cin >> ventas[i];
        
        total += ventas[i];
        
        if (i == 0 || ventas[i] > mayor) {
            mayor = ventas[i];
            dia_mayor = i;
        }
        if (i == 0 || ventas[i] < menor) {
            menor = ventas[i];
            dia_menor = i;
        }
    }
    
    float promedio = total / 7;
    int dias_sup_promedio = 0;
    
    for (int i = 0; i < 7; i++) {
        if (ventas[i] > promedio) {
            dias_sup_promedio++;
        }
    }
    
    cout << "\nTotal vendido: " << total << "\n";
    cout << "Promedio de ventas: " << promedio << "\n";
    cout << "Dia con mayor venta: " << dias[dia_mayor] << " (" << mayor << ")\n";
    cout << "Dia con menor venta: " << dias[dia_menor] << " (" << menor << ")\n";
    cout << "Dias con ventas superiores al promedio: " << dias_sup_promedio << "\n";
    
    return 0;
}
Ejercicio 3

C++
#include <iostream>
#include <vector>

using namespace std;

int main() {
    vector<float> temp(15);
    float suma = 0, mayor = 0, menor = 0;
    
    for (int i = 0; i < 15; i++) {
        cout << "Temperatura dia " << i + 1 << ": ";
        cin >> temp[i];
        
        suma += temp[i];
        
        if (i == 0 || temp[i] > mayor) {
            mayor = temp[i];
        }
        if (i == 0 || temp[i] < menor) {
            menor = temp[i];
        }
    }
    
    float promedio = suma / 15;
    int dias_mayor_promedio = 0;
    int dias_menor_10 = 0;
    
    cout << "\nTemperaturas registradas: \n";
    for (int i = 0; i < 15; i++) {
        cout << temp[i] << " ";
        
        if (temp[i] > promedio) {
            dias_mayor_promedio++;
        }
        if (temp[i] < 10) {
            dias_menor_10++;
        }
    }
    cout << "\n\n";
    
    cout << "Temperatura maxima: " << mayor << "\n";
    cout << "Temperatura minima: " << menor << "\n";
    cout << "Promedio general: " << promedio << "\n";
    cout << "Dias con temperatura mayor al promedio: " << dias_mayor_promedio << "\n";
    cout << "Dias con temperatura menor a 10 grados: " << dias_menor_10 << "\n";
    
    return 0;
}
