Ejercicio 1

C++
#include <iostream>

using namespace std;

int calcularSuma(int n) {
    int suma = 0;
    for (int i = 1; i <= n; i++) {
        suma += i;
    }
    return suma;
}

int main() {
    int n;
    cout << "Ingrese N: ";
    cin >> n;
    
    if (n > 0) {
        cout << "Suma total: " << calcularSuma(n) << "\n";
    }
    
    return 0;
}
Ejercicio 2

C++
#include <iostream>

using namespace std;

float calcularPromedio(int n) {
    float suma = 0, valor;
    for (int i = 0; i < n; i++) {
        cout << "Ingrese el valor " << i + 1 << ": ";
        cin >> valor;
        suma += valor;
    }
    return suma / n;
}

int main() {
    int n;
    cout << "Cantidad de valores a ingresar: ";
    cin >> n;
    
    if (n > 0) {
        cout << "Promedio: " << calcularPromedio(n) << "\n";
    }
    
    return 0;
}
Ejercicio 3

C++
#include <iostream>

using namespace std;

int contarPares(long long n) {
    int pares = 0;
    
    if (n < 0) n = -n;
    if (n == 0) return 1;
    
    while (n > 0) {
        if ((n % 10) % 2 == 0) {
            pares++;
        }
        n /= 10;
    }
    return pares;
}

int main() {
    long long numero;
    cout << "Ingrese un numero entero: ";
    cin >> numero;
    
    cout << "Cantidad de digitos pares: " << contarPares(numero) << "\n";
    
    return 0;
}
