Ejercicio 2

C++
#include <iostream>
#include <string>

using namespace std;

void leerFecha(int &dia, int &mes, int &anio) {
    cout << "Dia: ";
    cin >> dia;
    cout << "Mes: ";
    cin >> mes;
    cout << "Anio: ";
    cin >> anio;
}

void LITERAL(int dia, int mes, int anio, string &mesLiteral, int &anioCompleto) {
    string meses[] = {"Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", 
                      "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"};
    
    if (mes >= 1 && mes <= 12) {
        mesLiteral = meses[mes - 1];
    } else {
        mesLiteral = "Invalido";
    }
    
    if (anio < 100) {
        if (anio > 50) {
            anioCompleto = 1900 + anio;
        } else {
            anioCompleto = 2000 + anio;
        }
    } else {
        anioCompleto = anio;
    }
}

void mostrarFecha(int dia, string mesLiteral, int anioCompleto) {
    cout << dia << " de " << mesLiteral << " de " << anioCompleto << "\n";
}

int main() {
    int dia, mes, anio, anioCompleto;
    string mesLiteral;
    
    leerFecha(dia, mes, anio);
    LITERAL(dia, mes, anio, mesLiteral, anioCompleto);
    mostrarFecha(dia, mesLiteral, anioCompleto);
    
    return 0;
}
Ejercicio 3

C++
#include <iostream>
#include <cmath>

using namespace std;

void leerDatos(float &R, int &n) {
    cout << "Numero real: ";
    cin >> R;
    cout << "Cantidad de decimales: ";
    cin >> n;
}

float redondear(float R, int n) {
    float factor = pow(10, n);
    return round(R * factor) / factor;
}

void mostrarResultado(float resultado) {
    cout << "Numero redondeado: " << resultado << "\n";
}

int main() {
    float R;
    int n;
    
    leerDatos(R, n);
    mostrarResultado(redondear(R, n));
    
    return 0;
}
